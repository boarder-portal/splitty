---
description: Import React hooks and types as named imports, not via React.*
globs: "**/*.{ts,tsx}"
alwaysApply: false
---

# React named imports

Import hooks, APIs, and types from `react` by name. Do not use `import * as React` or `React.useState` / `React.ReactNode`.

```tsx
// BAD
import * as React from "react"

const Context = React.createContext(null)
React.useEffect(() => {}, [])

function Box({ children }: { children: React.ReactNode }) {}

// GOOD
import {
  createContext,
  useEffect,
  useState,
  type ReactNode,
} from "react"

const Context = createContext(null)
useEffect(() => {}, [])

function Box({ children }: { children: ReactNode }) {}
```
